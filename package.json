{
  "name": "aredl-desktop",
  "version": "1.1.2",
  "description": "AREDL Desktop",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/dist.js",
    "release": "node scripts/release-notes.js --strict && electron-builder --win nsis portable --publish always",
    "ship": "node scripts/ship.js",
    "dist:mac": "node scripts/release-notes.js && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "net.aredl.desktop.unofficial",
    "productName": "AREDL Desktop",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "mac-updater.js",
      "settings-transfer.js",
      "sync.js",
      "drive.js",
      "drive-config.js",
      "drive-config.local.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "AREDL-Desktop-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AREDL Desktop",
      "artifactName": "AREDL-Desktop-Setup.exe"
    },
    "asarUnpack": [
      "assets/icon.ico"
    ],
    "publish": {
      "provider": "github",
      "owner": "FriedKemono",
      "repo": "aredl-desktop",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "AREDL-Desktop-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "AREDL Desktop"
    }
  }
}
